{
  "name": "reachinbox-email-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack email scheduler: Express API, BullMQ workers, transactional outbox, Ethereal SMTP, Elasticsearch search, React dashboard.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait postgres redis elasticsearch",
    "infra:down": "docker compose stop postgres redis elasticsearch",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:ethereal": "tsx scripts/seed-ethereal.ts",
    "search:reindex": "tsx scripts/reindex.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:dispatcher": "tsx watch apps/dispatcher/src/main.ts",
    "dev:web": "pnpm --filter @reachinbox/web dev",
    "dev": "concurrently -n api,worker,dispatcher,web -c blue,green,magenta,yellow \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:dispatcher\" \"pnpm dev:web\"",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "start:dispatcher": "node apps/dispatcher/dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @reachinbox/web typecheck",
    "build": "node scripts/build.mjs && pnpm --filter @reachinbox/web build",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:all": "vitest run && playwright test -c tests/e2e/playwright.config.ts",
    "format": "prettier --write .",
    "dev:smtp-sink": "tsx tests/fixtures/run-sink.ts",
    "seed:local-sink": "tsx scripts/seed-local-sink.ts",
    "dev:session": "tsx tests/fixtures/dev-session.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@reachinbox/core": "workspace:*",
    "@reachinbox/db": "workspace:*",
    "nodemailer": "10.3.1"
  },
  "type": "module"
}
