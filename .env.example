# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails-v1

# --- HTTP / origins ---------------------------------------------------------
# Public origin of the web app (Vite dev server). OAuth redirect URIs are derived from it
# and Vite proxies /auth and /api to the API, so cookies stay same-origin.
APP_PUBLIC_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
API_PROXY_TARGET=http://localhost:3001
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Random string, >= 32 chars. Used as HMAC key for session token hashes.
SESSION_SECRET=change-me-to-a-random-32-plus-char-string

# --- Secrets at rest --------------------------------------------------------
# 32 bytes base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Google OAuth (OpenID Connect) -----------------------------------------
# Authorized redirect URI: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
# Comma-separated Google account emails allowed to open /admin/queues (Bull Board, read-only).
OPERATOR_EMAILS=

# --- Slack OAuth v2 (incoming webhook) --------------------------------------
# Redirect URL in the Slack app: http://localhost:5173/auth/slack/callback
# Scope requested: incoming-webhook only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Sending / rate limits (demo-safe defaults) -----------------------------
WORKER_CONCURRENCY=5
# Minimum gap between two SMTP attempts from the same sender (protective pacing).
MIN_SEND_DELAY_MS=2000
# Protective hourly cap per sender across all campaigns (UTC fixed hour windows).
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Number of Ethereal sender accounts `pnpm seed:ethereal` keeps provisioned.
SENDER_COUNT=2
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# --- Request / import limits ------------------------------------------------
MAX_RECIPIENTS_PER_CAMPAIGN=10000
MAX_JSON_BODY_BYTES=5242880
DISPATCHER_BATCH_SIZE=200
OUTBOX_LEASE_MS=30000
